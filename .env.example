# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Leave both empty to run the fully offline demo mode (localStorage + same-browser tabs).

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → publishable / anon key (safe for the browser)
VITE_SUPABASE_ANON_KEY=

# Optional: name of the realtime room (change it if you ever want a fresh room)
VITE_ROOM_ID=our-little-world

# NEVER put the service_role / secret key in any VITE_ variable.
